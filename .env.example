# Optional settings read by compose.yml. Copy to .env next to compose.yml and
# fill in only what you need: every value below is the default, and a normal
# install configures everything else in the browser.

# Time zone used in the log. Recordings are always stored in UTC.
TZ=Europe/Lisbon
SENTINEL_LOG_LEVEL=INFO

# Optional footage viewer. See docs/remote-access.md.
SENTINEL_VIEWER_ENABLED=false
SENTINEL_VIEWER_TRUSTED_HOSTS=
SENTINEL_VIEWER_KEY=

# Cloudflare Access single sign-on for the viewer. Empty denies that grant only.
SENTINEL_VIEWER_CLOUDFLARE_ISSUER=
SENTINEL_VIEWER_CLOUDFLARE_AUDIENCES=

# Exact proxy networks allowed to supply CF-Connecting-IP. Never a broad LAN range.
SENTINEL_TRUSTED_PROXY_CIDRS=

# Exact HTTPS origin allowed to embed the interface, e.g. your Home Assistant.
SENTINEL_FRAME_ANCESTORS=
SENTINEL_COOKIE_SECURE=false

# Live video in Home Assistant through a password-protected RTSP relay on port
# 8554. See docs/home-assistant.md.
SENTINEL_HOME_ASSISTANT_LIVE=false

#!/bin/sh
set -eu

APP_DIR="${SENTINEL_APP_DIR:-/opt/sentinel-cctv}"
COMPOSE_FILES="-f compose.yml -f compose.source.yml"

cd "$APP_DIR"

compose() {
    # shellcheck disable=SC2086
    docker compose $COMPOSE_FILES "$@"
}

clean_checkout() {
    if [ -n "$(git status --porcelain)" ]; then
        echo "Checkout has local changes; review them before deploying." >&2
        exit 1
    fi
}

rebuild() {
    clean_checkout
    # Capture the running image, not a mutable build tag. A failed build
    # leaves the old container running and its rollback image intact.
    previous_image=$(docker inspect --format '{{.Image}}' sentinel 2>/dev/null || true)
    if [ -n "$previous_image" ]; then
        rollback_tag="sentinel-cctv:before-$(date -u +%Y%m%dT%H%M%SZ)"
        docker image tag "$previous_image" "$rollback_tag"
        echo "Rollback image retained: $rollback_tag"
        echo "To restore it: sentinel-ctl rollback $rollback_tag"
    fi
    compose build sentinel
    compose up -d --no-build sentinel
    attempts=0
    until curl -fsS --max-time 5 http://127.0.0.1:8090/api/v1/system/health; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 20 ]; then
            echo "Health check failed; inspect logs and the retained rollback image." >&2
            echo "No automatic database downgrade or footage cleanup was attempted." >&2
            exit 1
        fi
        sleep 2
    done
    printf '\n'
}

case "${1:-help}" in
    status)
        compose ps
        ;;
    health)
        curl -fsS http://127.0.0.1:8090/api/v1/system/health
        printf '\n'
        ;;
    logs)
        compose logs -f --tail=200 sentinel
        ;;
    restart)
        compose restart sentinel
        ;;
    update)
        clean_checkout
        git pull --ff-only
        rebuild
        ;;
    rebuild)
        rebuild
        ;;
    rollback)
        # Retained local images only. Never pull an unreviewed replacement.
        case "${2:-}" in
            sentinel-cctv:before-*) ;;
            *) echo "Supply a retained sentinel-cctv:before-* image." >&2; exit 1 ;;
        esac
        docker image inspect "$2" >/dev/null
        echo "Restoring image only; source and database migrations are unchanged."
        echo "Use only after checking schema compatibility for the release."
        docker image tag "$2" sentinel-cctv:local
        compose up -d --no-build sentinel
        ;;
    stop)
        compose stop
        ;;
    start)
        compose up -d
        ;;
    *)
        cat <<'EOF'
Usage: sentinel-ctl <command>

  status    Show container state
  health    Query Sentinel readiness
  logs      Follow recent application logs
  restart   Restart Sentinel
  update    Fast-forward the private checkout and rebuild
  rebuild   Rebuild from the current checkout
  rollback <image>  Restore a retained before-* image (no database downgrade)
  stop      Stop Sentinel
  start     Start Sentinel
EOF
        ;;
esac
